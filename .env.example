# Target API for integration + load tests
BASE_URL=http://127.0.0.1:8000

# Magic OTP (must match backend USE_TEST_OTP=True + MAGIC_OTP)
MAGIC_OTP=123456
USE_TEST_OTP=true

# Bot / captcha off
REQUIRE_CAPTCHA=false

# Face verification off (use mock-complete)
FACE_VERIFICATION=false
ALLOW_MOCK_VERIFICATION=true

# Timeouts
HTTP_TIMEOUT_SECONDS=30

# Load test defaults
LOCUST_USERS=20
LOCUST_SPAWN_RATE=5
LOCUST_RUN_TIME=60s
